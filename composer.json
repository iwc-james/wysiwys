{
    "name": "iwc-james/wysiwys",
    "description": "Éditeur WYSIWYG simple pour Laravel, avec upload d'images sans storage:link.",
    "type": "library",
    "license": "MIT",
    "authors": [
        { "name": "James Dervin", "email": "jamesouille.dervin@gmail.com" }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": { "IwcJames\\Wysiwys\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "IwcJames\\Wysiwys\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["IwcJames\\Wysiwys\\WysiwysServiceProvider"]
        }
    },
    "scripts": {
        "test": "pest",
        "serve": "testbench serve"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
